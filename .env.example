# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Shown in the header, footer and AI prompts
NEXT_PUBLIC_BRAND_NAME=Hayaurie
# Where custom design requests are sent (mailto link)
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Optional: semantic search for the /help assistant (https://dash.voyageai.com). Without it, keyword search is used.
VOYAGE_API_KEY=
# Optional: turns on the catalog MCP server at /api/mcp. Clients send "Authorization: Bearer <this value>". Use a long random string.
MCP_API_KEY=
